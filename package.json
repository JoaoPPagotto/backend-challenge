{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist --external pg-native",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "migration:create": "bun scripts/migrate.ts create",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:load": "bun run scripts/load-test.ts",
    "infra:up": "docker compose --profile test up -d --wait postgres-test localstack-test",
    "infra:down": "docker compose --profile test rm -sfv postgres-test localstack-test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1146.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "decimal.js": "10.6.0",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
